# ============================================================
# YT Video Generation Pipeline — root runtime configuration
# ============================================================
# Copy once:
#   cp .env.example .env
#
# IMPORTANT:
# - .env is local and Git-ignored.
# - This root .env is the authoritative runtime config.
# - Do NOT create/edit .env files inside services/ajil_uag or its nested modules.

# ------------------------------------------------------------
# Pipeline -> STT / timing
# ------------------------------------------------------------
YT_ENV_FILE=.env
YT_STT_BACKEND=ajil
YT_STT_LANGUAGE=en
YT_STT_TIMEOUT_SEC=120

# ------------------------------------------------------------
# Pipeline -> ElevenLabs browser voiceover (web UI only; no API key)
# ------------------------------------------------------------
# The authenticated Chrome profile is the same Ordak-managed browser session.
YT_ELEVENLABS_HOME_URL=https://elevenlabs.io/app/home
YT_ELEVENLABS_DOWNLOAD_DIR=~/Downloads
YT_ELEVENLABS_POLL_SECONDS=5
YT_ELEVENLABS_GENERATION_TIMEOUT_SECONDS=900
YT_ELEVENLABS_STALL_REFRESH_SECONDS=90
YT_ELEVENLABS_MAX_STALL_REFRESHES=3
# Leave defaults blank to preserve the currently selected ElevenLabs UI choices.
YT_ELEVENLABS_DEFAULT_VOICE=
YT_ELEVENLABS_DEFAULT_MODEL=
YT_NAVIGATION_ADVISOR_ENABLED=true
YT_NAVIGATION_AJIL_BASE_URL=http://127.0.0.1:8188

# Ajil client settings used by scripts/align_beats.py
YT_AJIL_BASE_URL=http://127.0.0.1:8080
# Leave blank to reuse UAG_AUTH_TOKEN below.
YT_AJIL_AUTH_TOKEN=
YT_AJIL_AUTH_HEADER_NAME=x-api-token

# Optional local faster-whisper fallback
YT_LOCAL_WHISPER_MODEL=small.en
YT_LOCAL_WHISPER_DEVICE=cpu
YT_LOCAL_WHISPER_COMPUTE_TYPE=int8

# ============================================================
# Ajil Unified AI Gateway
# These UAG_* values configure the Ajil submodule from ROOT.
# ============================================================

# ------------------------------------------------------------
# Ajil app
# ------------------------------------------------------------
UAG_APP_HOST=127.0.0.1
UAG_APP_PORT=8080
UAG_APP_LOG_LEVEL=INFO
UAG_APP_DOCS_ENABLED=true

# ------------------------------------------------------------
# Logging / observability
# ------------------------------------------------------------
UAG_LOG_ENABLED=true
UAG_LOG_JSON=true
UAG_LOG_HTTP_REQUESTS=true
UAG_LOG_ROUTER_DISPATCH=true
UAG_LOG_PROVIDER_ATTEMPTS=true
UAG_LOG_WEBSOCKET=true
UAG_LOG_MAX_EVENTS=50000
UAG_USAGE_MAX_EVENTS=20000

# ------------------------------------------------------------
# Client/admin auth
# ------------------------------------------------------------
UAG_AUTH_ENABLED=true
UAG_AUTH_TOKEN=change_me_local_client_token
UAG_AUTH_HEADER_NAME=x-api-token

UAG_ADMIN_ENABLED=true
UAG_ADMIN_TOKEN=change_me_local_admin_token
UAG_ADMIN_HEADER_NAME=x-admin-token

# ------------------------------------------------------------
# Router
# ------------------------------------------------------------
UAG_ROUTER_DEFAULT_STRATEGY=fallback_chain
UAG_ROUTER_DEFAULT_MODE=latency_first
UAG_ROUTER_PARALLEL_TIMEOUT_SEC=25
UAG_ROUTER_MAX_CANDIDATES=6
UAG_ROUTER_FALLBACK_MAX_ATTEMPTS=6
UAG_ROUTER_FALLBACK_ATTEMPT_TIMEOUT_SEC=12
UAG_ROUTER_FALLBACK_ROUND_BACKOFF_SEC=0.2
UAG_ROUTER_RETRYABLE_STATUS_CODES=408,409,425,429,500,502,503,504
UAG_ROUTER_STRICT_RATE_LIMIT_ERRORS_ONLY=false

# ------------------------------------------------------------
# Shared outbound proxy
# ------------------------------------------------------------
UAG_PROXY_ENABLED=false
UAG_PROXY_URL=socks5://127.0.0.1:2080

# Docker-oriented values are included here so the same root env can
# later drive Ajil via compose if desired.
UAG_PROXY_URL_DOCKER=http://proxy2080:2080
UAG_PROXY_USE_COMPOSE_SERVICE=false
UAG_DOCKER_BUILD_NETWORK=default
UAG_BUILD_HTTP_PROXY=
UAG_BUILD_HTTPS_PROXY=
UAG_BUILD_ALL_PROXY=
UAG_BUILD_NO_PROXY=127.0.0.1,localhost
UAG_PIP_INDEX_URL=
UAG_PIP_EXTRA_INDEX_URL=

# ------------------------------------------------------------
# Redis
# ------------------------------------------------------------
UAG_REDIS_REQUIRED=false
UAG_REDIS_URL=redis://127.0.0.1:6379/0
UAG_REDIS_URL_DOCKER=redis://redis:6379/0
UAG_REDIS_HOST_PORT=6379
UAG_REDIS_KEY_PREFIX=uag
UAG_REDIS_DEFAULT_LIMIT_PER_MINUTE=120

# ============================================================
# Embedded Gemini provider
# Disabled by default for the current STT-only stage.
# All embedded runtime controls live here, not in the submodule.
# ============================================================
UAG_GEMINI_ENABLED=false
UAG_GEMINI_REQUEST_TIMEOUT_SEC=120
UAG_GEMINI_MODE=gemini_direct
UAG_GEMINI_TRUST_ENV_PROXY=true
UAG_GEMINI_FORCE_IPV4=false
UAG_GEMINI_BASE_URL=https://generativelanguage.googleapis.com
UAG_GEMINI_API_VERSION=v1beta
UAG_GEMINI_DEFAULT_MODEL=gemini-2.5-flash
UAG_GEMINI_API_KEYS=
UAG_GEMINI_DEFAULT_REQUEST_JSON={}
UAG_GEMINI_RETRY_ON_429=true
UAG_GEMINI_RETRY_ON_5XX=true
UAG_GEMINI_MAX_RETRIES_PER_KEY=2
UAG_GEMINI_MAX_RETRIES_ON_5XX=4
UAG_GEMINI_RETRY_BACKOFF_SEC=0.35
UAG_GEMINI_COOLOFF_SEC=20
UAG_GEMINI_MIN_INTERVAL_SEC=0

# Gemini Cloudflare-worker mode
UAG_GEMINI_WORKER_BASE_URLS=
UAG_GEMINI_WORKER_ROUTE_PREFIX=/gemini
UAG_GEMINI_WORKER_AUTH_TOKEN=
UAG_GEMINI_WORKER_AUTH_HEADER_NAME=x-worker-auth
UAG_GEMINI_WORKER_ACCESS_CLIENT_ID=
UAG_GEMINI_WORKER_ACCESS_CLIENT_SECRET=
UAG_GEMINI_WORKER_PASS_TRACE_HEADERS=true

# ============================================================
# Embedded Groq provider
# This is the current STT backend.
# ============================================================
UAG_GROQ_ENABLED=true
UAG_GROQ_REQUEST_TIMEOUT_SEC=90
UAG_GROQ_BASE_URL=https://api.groq.com/openai/v1
# Comma-separated pool. One key is enough to start.
UAG_GROQ_API_KEYS=replace_with_groq_key

# STT: high-speed large model first, accuracy-oriented large model fallback.
UAG_GROQ_STT_PRIMARY_MODEL=whisper-large-v3-turbo
UAG_GROQ_STT_FALLBACK_MODEL=whisper-large-v3
UAG_GROQ_STT_LANGUAGE=en
UAG_GROQ_STT_TEMPERATURE=0
UAG_GROQ_STT_RESPONSE_FORMAT=verbose_json
# word is required for precise beat alignment; segment is useful for diagnostics.
UAG_GROQ_STT_TIMESTAMP_GRANULARITIES=word,segment
UAG_GROQ_STT_PROMPT=

# TTS settings exposed by the same embedded Groq provider.
UAG_GROQ_TTS_DEFAULT_MODEL=canopylabs/orpheus-v1-english
UAG_GROQ_TTS_DEFAULT_VOICE=diana
UAG_GROQ_TTS_DEFAULT_RESPONSE_FORMAT=wav

# Retry / multi-key policy
UAG_GROQ_RETRY_ON_429=true
UAG_GROQ_RETRY_ON_5XX=true
UAG_GROQ_MAX_RETRIES_PER_KEY=2
UAG_GROQ_MAX_RETRIES_ON_5XX=4
UAG_GROQ_RETRY_BACKOFF_SEC=0.35
UAG_GROQ_COOLOFF_SEC=20
UAG_GROQ_MIN_INTERVAL_SEC=0

# ============================================================
# Embedded Pollinations provider
# Disabled by default for the current pipeline stage.
# ============================================================
UAG_POLLINATIONS_ENABLED=false
UAG_POLLINATIONS_REQUEST_TIMEOUT_SEC=120
UAG_POLLINATIONS_BASE_URL=https://gen.pollinations.ai
UAG_POLLINATIONS_API_KEYS=
UAG_POLLINATIONS_DEFAULT_IMAGE_MODEL=flux
UAG_POLLINATIONS_USE_PROXY_2080=false
UAG_POLLINATIONS_PROXY_2080_URL=socks5://127.0.0.1:2080
UAG_POLLINATIONS_TRUST_ENV_PROXY=false
UAG_POLLINATIONS_MAX_ATTEMPTS_PER_REQUEST=6
UAG_POLLINATIONS_RETRY_STATUS_CODES=402,429,500,502,503,504
UAG_POLLINATIONS_RETRY_BACKOFF_SEC=0.35
UAG_POLLINATIONS_KEY_COOLDOWN_SEC=20
UAG_POLLINATIONS_LOCAL_PLACEHOLDER_ON_FAILURE=true

# Image normalization defaults used by the embedded Pollinations adapter
UAG_IMAGE_DEFAULT_N=1
UAG_IMAGE_DEFAULT_SIZE=1024x1024
UAG_IMAGE_DEFAULT_QUALITY=medium
UAG_IMAGE_DEFAULT_RESPONSE_FORMAT=b64_json

# ============================================================
# Ordak — real ChatGPT browser automation
# services/ordak is pinned to the yt-video-pipeline branch.
# The ROOT .env remains authoritative; scripts/run_ordak.py maps
# these YT_ORDAK_* settings into Ordak's native environment.
# ============================================================
YT_ORDAK_ENABLED=true
YT_ORDAK_BASE_URL=http://127.0.0.1:8000
YT_ORDAK_APP_HOST=127.0.0.1
YT_ORDAK_APP_PORT=8000
# Ordak uses its own supported interpreter rather than the parent pipeline's
# Python.  Leave blank to use services/ordak/.venv/bin/python.
YT_ORDAK_PYTHON=

# Active browser/provider scope for the current pipeline stage.
YT_ORDAK_PROVIDER=chatgpt
YT_ORDAK_CHATGPT_URL=https://chatgpt.com/
# Optional: set to the exact ChatGPT Project URL if you want all
# pipeline chats isolated inside one ChatGPT project.
YT_ORDAK_CHATGPT_PROJECT_URL=

# Main authenticated Chrome profile selected by the user.
# Codex/Ordak must use this configured profile, not invent a new
# logged-out browser profile.
YT_ORDAK_BROWSER_PLATFORM=linux
YT_ORDAK_BROWSER_EXECUTABLE_PATH=/usr/bin/google-chrome
YT_ORDAK_BROWSER_USER_DATA_DIR=/home/<your-user>/.config/google-chrome
YT_ORDAK_BROWSER_PROFILE_NAME=Default

# Linux DevTools attach endpoint.
YT_ORDAK_BROWSER_REMOTE_DEBUGGING_URL=http://127.0.0.1:9222
# When Chrome is closed, safely launch the exact configured profile with
# DevTools. If Chrome is already running without DevTools, Ordak refuses to
# launch a second/fallback profile and reports the required restart action.
YT_ORDAK_BROWSER_REMOTE_DEBUGGING_AUTO_LAUNCH=true
YT_ORDAK_BROWSER_REMOTE_DEBUGGING_LAUNCH_TIMEOUT_MS=45000

# Browser/UI timeouts. Image generation can legitimately take minutes.
YT_ORDAK_BROWSER_TIMEOUT_MS=180000
YT_ORDAK_CHATGPT_RESPONSE_TIMEOUT_MS=600000
YT_ORDAK_CHATGPT_STABLE_RESPONSE_SECONDS=5

# Stall recovery policy. A "stall" must be distinguished from active
# generation. If ChatGPT is still visibly working, continue waiting.
# If no meaningful progress is observed for this window, refresh/reconcile.
YT_ORDAK_CHATGPT_STALL_REFRESH_SECONDS=90
YT_ORDAK_CHATGPT_MAX_STALL_REFRESHES=3

# Parent-side API wait/poll defaults for long-running jobs.
YT_ORDAK_JOB_WAIT_TIMEOUT_SECONDS=900
YT_ORDAK_JOB_POLL_INTERVAL_SECONDS=2

# Ordak operational storage remains local under the submodule by default.
# Generated beat images are copied/moved into the parent video's
# assets/raw_beats/ directory by the pipeline workflow.
