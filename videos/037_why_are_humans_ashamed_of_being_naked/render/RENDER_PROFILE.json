{
  "schema_version": 1,
  "aspect_ratio": "9:16",
  "resolution": {
    "width": 1080,
    "height": 1920
  },
  "fps": 30,
  "video": {
    "codec": "libx264",
    "preset": "medium",
    "crf": 18,
    "pixel_format": "yuv420p"
  },
  "audio": {
    "codec": "aac",
    "bitrate": "192k"
  },
  "resource_limits": {
    "ffmpeg_threads": 2,
    "filter_threads": 2,
    "filter_complex_threads": 2
  },
  "motion": {
    "enabled": true,
    "strength": 0.14,
    "supersample": 2,
    "cycle": [
      "zoom_in"
    ],
    "image_zoom_policy": "push_in_except_final_pull_out"
  },
  "transitions": {
    "image_beat_style": "cut_fade_dissolve",
    "image_beat_seconds": 0.28,
    "opening_to_image_type": "fade",
    "opening_to_image_seconds": 0.28,
    "default_type": "fade",
    "default_seconds": 0.3,
    "ai_selection_enabled": false,
    "manual_overrides": [
      {
        "from_beat_id": "video_opening_a",
        "to_beat_id": "video_opening_b",
        "type": "fade",
        "duration": 0.2
      },
      {
        "from_beat_id": "video_opening_b",
        "to_beat_id": "1",
        "type": "fade",
        "duration": 0.2
      },
      {
        "from_beat_id": "1",
        "to_beat_id": "2",
        "type": "fade",
        "duration": 0.2
      },
      {
        "from_beat_id": "2",
        "to_beat_id": "3",
        "type": "fade",
        "duration": 0.2
      },
      {
        "from_beat_id": "3",
        "to_beat_id": "4",
        "type": "fade",
        "duration": 0.2
      }
    ]
  },
  "subtitles": {
    "enabled": true,
    "font_name": "Wonderbar",
    "font_size": 120,
    "bold": false,
    "outline": 8.0,
    "shadow": 0,
    "max_words_per_cue": 1,
    "max_chars_per_line": 34,
    "max_lines": 2,
    "word_highlight": {
      "enabled": false,
      "active_colour": "&H0000D7FF",
      "inactive_colour": "&H00F5F5F5",
      "outline_colour": "&H00130D09"
    },
    "italic": true,
    "position": "custom",
    "custom_offset_value": 25.0,
    "custom_offset_unit": "percent",
    "font_colour": "#B6FF00",
    "outline_colour": "#3C1A47"
  },
  "branding": {
    "logo": {
      "enabled": false,
      "source": "",
      "sha256": "",
      "position": "custom",
      "width_percent": 14.0,
      "opacity": 1.0,
      "margin_x_percent": 3.0,
      "margin_y_percent": 2.5,
      "custom_x_percent": 8.0,
      "custom_y_percent": 4.5
    },
    "title": {
      "enabled": true,
      "text": "Why Are Humans Ashamed of Being Naked?",
      "position": "top_center",
      "font_name": "Gruze Drip",
      "font_size": 110,
      "bold": false,
      "italic": false,
      "text_align": "center",
      "max_words_per_line": 4,
      "line_spacing": 0.0,
      "max_width_percent": 90.0,
      "margin_x_percent": 0.0,
      "margin_y_percent": 4.0,
      "logo_gap_percent": 1.0,
      "custom_x_percent": 23.0,
      "custom_y_percent": 2.5,
      "font_colour": "#F2F2F2",
      "outline_colour": "#000000",
      "outline": 4.0
    },
    "watermark": {
      "enabled": true,
      "text": "Q Station",
      "position": "bottom_center",
      "font_name": "Gruze Drip",
      "font_size": 120,
      "opacity": 0.35,
      "bold": false,
      "italic": false,
      "text_align": "center",
      "max_words_per_line": 7,
      "line_spacing": 6.0,
      "max_width_percent": 90.0,
      "margin_x_percent": 3.0,
      "margin_y_percent": 8.5,
      "logo_gap_percent": 1.0,
      "custom_x_percent": 80.0,
      "custom_y_percent": 88.0,
      "font_colour": "#FFFFFF",
      "outline_colour": "#000000",
      "outline": 2.0
    }
  }
}
