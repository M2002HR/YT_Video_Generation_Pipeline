  "segments": [
    {
      "segment": "opening_question_spark",
      "narration": "Why can a naked statue feel proper when a naked person feels exposed?",
      "speech_start": 0.04,
      "speech_end": 4.9,
      "match_confidence": 1.0
    },
    {
      "segment": "entry_transition",
      "narration": "Because shame often follows learned expectations about where nakedness belongs.",
      "speech_start": 5.76,
      "speech_end": 11.1,
      "match_confidence": 1.0
    },
    {
      "segment": "body_01",
      "narration": "Families and customs teach rules about modesty.",
      "speech_start": 11.44,
      "speech_end": 14.06,
      "match_confidence": 1.0
    },
    {
      "segment": "body_02",
      "narration": "Those rules vary across cultures and history.",
      "speech_start": 14.58,
      "speech_end": 16.92,
      "match_confidence": 1.0
    },
    {
      "segment": "body_03",
      "narration": "Chosen privacy differs from unexpected exposure.",
      "speech_start": 17.88,
      "speech_end": 21.7,
      "match_confidence": 1.0
    },
    {
      "segment": "body_04",
      "narration": "Context can also make nudity feel sexual.",
      "speech_start": 22.16,
      "speech_end": 25.04,
      "match_confidence": 1.0
    },
    {
      "segment": "body_05",
      "narration": "Expected staring or judgment can trigger shame.",
      "speech_start": 26.08,
      "speech_end": 29.0,
      "match_confidence": 1.0
    },
    {
      "segment": "body_06",
      "narration": "Galleries may present nude statues as ordinary art.",
      "speech_start": 29.64,
      "speech_end": 32.82,
      "match_confidence": 1.0
    },
    {
      "segment": "body_07",
      "narration": "Changing booths usually signal concealment from strangers.",
      "speech_start": 33.16,
      "speech_end": 37.16,
      "match_confidence": 1.0
    },
    {
      "segment": "optional_closing",
      "narration": "The skin stays ordinary; the social meaning changes.",
      "speech_start": 37.06,
      "speech_end": 40.62,
      "match_confidence": 1.0
    },
    {
      "segment": "cta",
      "narration": "What do you think shapes our feelings about nudity most?",
      "speech_start": 41.24,
