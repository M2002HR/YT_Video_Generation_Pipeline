  "segments": [
    {
      "segment": "opening_question_spark",
      "narration": "If food is everywhere, why can the same few meals still fail you?",
      "speech_start": 0.0,
      "speech_end": 4.1,
      "match_confidence": 1.0
    },
    {
      "segment": "entry_transition",
      "narration": "The clue is what those repeated meals actually provide.",
      "speech_start": 4.62,
      "speech_end": 8.04,
      "match_confidence": 1.0
    },
    {
      "segment": "body_01",
      "narration": "Calories give your body energy.",
      "speech_start": 8.38,
      "speech_end": 10.02,
      "match_confidence": 1.0
    },
    {
      "segment": "body_02",
      "narration": "Health also needs vitamins, minerals, protein, and fats.",
      "speech_start": 9.94,
      "speech_end": 12.62,
      "match_confidence": 1.0
    },
    {
      "segment": "body_03",
      "narration": "Eating only a few foods may still leave nutrient gaps.",
      "speech_start": 13.2,
      "speech_end": 16.4,
      "match_confidence": 1.0
    },
    {
      "segment": "body_04",
      "narration": "Over time, those gaps can cause health problems.",
      "speech_start": 16.9,
      "speech_end": 19.2,
      "match_confidence": 1.0
    },
    {
      "segment": "body_05",
      "narration": "Fresh plants may add nutrients those repeated meals miss.",
      "speech_start": 19.88,
      "speech_end": 23.96,
      "match_confidence": 1.0
    },
    {
      "segment": "body_06",
      "narration": "Clean drinking water is essential every day.",
      "speech_start": 23.38,
      "speech_end": 26.1,
      "match_confidence": 1.0
    },
    {
      "segment": "body_07",
      "narration": "Shelter protects you from heat, rain, and storms.",
      "speech_start": 26.54,
      "speech_end": 28.9,
      "match_confidence": 1.0
    },
    {
      "segment": "body_08",
      "narration": "Injuries or infections can become dangerous without medical care.",
      "speech_start": 29.6,
      "speech_end": 33.58,
      "match_confidence": 1.0
    },
    {
      "segment": "body_09",
      "narration": "Even perfect nutrition cannot stop normal aging.",
      "speech_start": 33.9,
      "speech_end": 37.04,
      "match_confidence": 1.0
    },
    {
      "segment": "optional_closing",
      "narration": "Plenty of food helps, but it cannot make you live forever.",
      "speech_start": 37.36,
      "speech_end": 40.0,
      "match_confidence": 1.0
    },
    {
      "segment": "cta",
      "narration": "Like this island challenge, and subscribe.",
      "speech_start": 40.0,
      "speech_end": 42.38,
      "match_confidence": 1.0
    }
  ]
