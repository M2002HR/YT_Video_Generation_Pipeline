      "speech_start": 42.54,
      "speech_end": 45.88,
      "match_confidence": 1.0,
      "motion": "zoom_in",
      "narration": "Models usually depend on what has already been observed.",
      "transition_in": "fade",
      "transition_seconds": 0.35,
      "transition_source": "default"
    },
    {
      "beat_id": 10,
      "media_type": "image",
