      "speech_start": 21.94,
      "speech_end": 25.08,
      "match_confidence": 1.0,
      "motion": "zoom_in",
      "narration": "Hindsight hides how surprising it really was.",
      "transition_in": "fade",
      "transition_seconds": 0.35,
      "transition_source": "default"
    },
    {
      "beat_id": 5,
      "media_type": "image",
