      "duration": 3.44,
      "speech_start": 30.18,
      "speech_end": 33.62,
      "match_confidence": 1.0,
      "motion": "zoom_in",
      "narration": "Then Europeans encountered black swans in Australia.",
      "transition_in": "fade",
      "transition_seconds": 0.35,
      "transition_source": "default"
    },
    {
      "beat_id": 7,
      "media_type": "image",
