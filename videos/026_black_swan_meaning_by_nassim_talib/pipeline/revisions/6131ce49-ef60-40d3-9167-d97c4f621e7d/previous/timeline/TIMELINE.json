      "speech_start": 45.88,
      "speech_end": 52.14,
      "match_confidence": 1.0,
      "motion": "zoom_in",
      "narration": "Markets can change through events those models barely considered.",
      "transition_in": "fade",
      "transition_seconds": 0.35,
      "transition_source": "default"
    },
    {
      "beat_id": 11,
      "media_type": "image",
