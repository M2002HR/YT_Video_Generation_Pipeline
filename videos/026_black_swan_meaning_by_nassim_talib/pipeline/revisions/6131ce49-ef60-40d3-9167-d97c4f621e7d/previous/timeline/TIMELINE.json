      "duration": 5.1,
      "speech_start": 25.08,
      "speech_end": 30.18,
      "match_confidence": 1.0,
      "motion": "zoom_in",
      "narration": "The name comes from Europe's old belief that all swans were white.",
      "transition_in": "fade",
      "transition_seconds": 0.35,
      "transition_source": "default"
    },
    {
      "beat_id": 6,
      "media_type": "image",
