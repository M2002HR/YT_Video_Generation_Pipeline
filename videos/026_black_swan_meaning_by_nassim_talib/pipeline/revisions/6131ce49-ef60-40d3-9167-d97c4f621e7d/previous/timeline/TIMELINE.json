      "speech_start": 38.72,
      "speech_end": 42.08,
      "match_confidence": 1.0,
      "motion": "zoom_in",
      "narration": "Taleb says forecasts can fail the same way.",
      "transition_in": "fade",
      "transition_seconds": 0.35,
      "transition_source": "default"
    },
    {
      "beat_id": 9,
      "media_type": "image",
