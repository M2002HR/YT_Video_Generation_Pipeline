      "speech_start": 33.62,
      "speech_end": 38.72,
      "match_confidence": 1.0,
      "motion": "zoom_in",
      "narration": "One observation shattered a rule that had seemed certain.",
      "transition_in": "fade",
      "transition_seconds": 0.35,
      "transition_source": "default"
    },
    {
      "beat_id": 8,
      "media_type": "image",
