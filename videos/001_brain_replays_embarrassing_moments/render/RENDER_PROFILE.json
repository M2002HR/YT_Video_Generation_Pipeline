{
  "schema_version": 1,
  "resolution": {
    "width": 1920,
    "height": 1080
  },
  "fps": 30,
  "video": {
    "codec": "libx264",
    "preset": "medium",
    "crf": 18,
    "pixel_format": "yuv420p"
  },
  "audio": {
    "codec": "aac",
    "bitrate": "192k"
  },
  "motion": {
    "enabled": true,
    "strength": 0.045,
    "cycle": [
      "zoom_in",
      "pan_right",
      "zoom_out",
      "pan_left"
    ]
  },
  "subtitles": {
    "enabled": true,
    "font_name": "DejaVu Sans",
    "font_size": 56,
    "bold": true,
    "margin_v": 90,
    "outline": 3,
    "shadow": 0,
    "max_words_per_cue": 6,
    "max_chars_per_line": 34,
    "max_lines": 2
  }
}
