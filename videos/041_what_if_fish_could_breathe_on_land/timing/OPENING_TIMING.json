      "match_confidence": 1.0
    },
    {
      "segment": "body_02",
      "narration": "The fish still needs water.",
      "speech_start": 12.1,
      "speech_end": 14.02,
      "match_confidence": 1.0
    },
    {
      "segment": "body_03",
      "narration": "Its body must handle dry ground.",
