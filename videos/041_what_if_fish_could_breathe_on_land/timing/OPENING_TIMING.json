    {
      "segment": "opening_question_spark",
      "narration": "If fish could breathe on land, why would they still need water?",
      "speech_start": 0.0,
      "speech_end": 4.18,
      "match_confidence": 1.0
    },
    {
      "segment": "entry_transition",
      "narration": "The answer starts with one change, not a whole new fish.",
