  "segments": [
    {
      "segment": "opening_question_spark",
      "narration": "If your weight was cut in half, would Earth feel the same?",
      "speech_start": 0.02,
      "speech_end": 3.42,
      "match_confidence": 1.0
    },
    {
      "segment": "book_transition",
      "narration": "A weaker pull could change how people move and how bridges carry loads.",
      "speech_start": 3.96,
      "speech_end": 8.66,
      "match_confidence": 1.0
    },
    {
      "segment": "body_01",
      "narration": "People would weigh half as much on Earth.",
      "speech_start": 9.36,
      "speech_end": 11.38,
      "match_confidence": 1.0
    },
    {
      "segment": "body_02",
      "narration": "They could jump higher and lift heavy objects more easily.",
      "speech_start": 11.84,
      "speech_end": 15.04,
      "match_confidence": 1.0
    },
    {
      "segment": "body_03",
      "narration": "A person could carry a large box with less effort.",
      "speech_start": 15.66,
      "speech_end": 18.46,
      "match_confidence": 1.0
    },
    {
      "segment": "body_04",
      "narration": "Bridges and buildings would face different forces.",
      "speech_start": 19.12,
      "speech_end": 21.62,
      "match_confidence": 1.0
    },
    {
      "segment": "body_05",
      "narration": "Some structures might need new designs.",
      "speech_start": 22.38,
      "speech_end": 24.62,
      "match_confidence": 1.0
    },
    {
      "segment": "body_06",
      "narration": "Cars and machines would move differently.",
      "speech_start": 25.2,
      "speech_end": 27.34,
      "match_confidence": 1.0
    },
    {
      "segment": "body_07",
      "narration": "Astronauts already experience very low gravity in space.",
      "speech_start": 28.38,
      "speech_end": 32.5,
      "match_confidence": 1.0
    },
    {
      "segment": "body_08",
      "narration": "A half-gravity Earth could look familiar but act differently.",
      "speech_start": 32.88,
      "speech_end": 37.5,
      "match_confidence": 0.8
    },
    {
      "segment": "body_09",
      "narration": "Many systems would need to adjust to lower weight.",
      "speech_start": 38.78,
      "speech_end": 41.72,
      "match_confidence": 1.0
    },
    {
      "segment": "optional_closing",
      "narration": "Lighter does not mean the same.",
