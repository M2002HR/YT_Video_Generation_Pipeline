      "narration": "New memories become harder to form.",
      "speech_start": 14.5,
      "speech_end": 16.54,
      "match_confidence": 1.0
    },
    {
      "segment": "body_04",
      "narration": "Reaction time slows during everyday moments.",
      "speech_start": 17.38,
      "speech_end": 20.02,
      "match_confidence": 1.0
    },
    {
      "segment": "body_05",
      "narration": "Mistakes and accidents become more likely.",
      "speech_start": 20.86,
      "speech_end": 23.1,
      "match_confidence": 1.0
    },
    {
      "segment": "body_06",
      "narration": "Mood can shift toward irritability or sadness.",
      "speech_start": 24.1,
      "speech_end": 26.82,
      "match_confidence": 1.0
    },
    {
      "segment": "body_07",
      "narration": "Hunger signals may push toward heavier foods.",
      "speech_start": 27.84,
      "speech_end": 30.56,
      "match_confidence": 1.0
    },
    {
      "segment": "body_08",
      "narration": "Blood sugar control can become harder over time.",
      "speech_start": 31.0,
      "speech_end": 33.54,
      "match_confidence": 1.0
    },
    {
      "segment": "body_09",
      "narration": "Blood pressure may rise with repeated short nights.",
      "speech_start": 34.58,
      "speech_end": 37.16,
      "match_confidence": 1.0
    },
    {
      "segment": "body_10",
      "narration": "Immune defenses can become less effective.",
      "speech_start": 38.26,
      "speech_end": 40.48,
      "match_confidence": 1.0
    },
    {
      "segment": "body_11",
      "narration": "Severe tiredness can trigger sudden microsleeps.",
      "speech_start": 41.8,
      "speech_end": 44.68,
      "match_confidence": 1.0
    },
    {
      "segment": "body_12",
      "narration": "Your brain may briefly stop responding normally.",
      "speech_start": 45.88,
      "speech_end": 48.12,
      "match_confidence": 1.0
    },
    {
      "segment": "body_13",
      "narration": "One short night often causes temporary effects.",
      "speech_start": 49.28,
      "speech_end": 52.04,
      "match_confidence": 1.0
    },
    {
      "segment": "body_14",
      "narration": "Repeated nights under five hours strain many systems.",
