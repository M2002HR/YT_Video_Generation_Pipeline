# Generated / downloaded media assets

# Current image pipeline: one generated image per beat
videos/**/assets/raw_beats/*
!videos/**/assets/raw_beats/.gitkeep

# Legacy storyboard-sheet assets (deprecated, kept ignored if they still exist locally)
videos/**/assets/raw_storyboards/*
!videos/**/assets/raw_storyboards/.gitkeep
videos/**/assets/cropped_beats/*
!videos/**/assets/cropped_beats/.gitkeep

videos/**/assets/audio/*
!videos/**/assets/audio/.gitkeep

videos/**/assets/renders/*
!videos/**/assets/renders/.gitkeep

# Optional Motion Director inspection media can be regenerated from the JSON plan.
videos/**/motion/debug/*
!videos/**/motion/debug/.gitkeep

# Canonical preset/reference images are intentionally tracked.
# Do NOT ignore visual_presets/** or videos/**/references/**

# Local/system files
.DS_Store
Thumbs.db
__pycache__/
*.pyc
.venv/
control_panel/
# The React Studio is deployable source and its locally-built bundle. Runtime jobs, logs and
# dependencies remain machine-local.
!control_panel/
control_panel/*
!control_panel/ui/
!control_panel/ui/**
!control_panel/dist/
!control_panel/dist/**
control_panel/ui/node_modules/
control_panel/jobs/
control_panel/services/
control_panel/*.log

# Root runtime secrets/config
.env
.env.local
.env.*.local

# Optional local audio-polish assets
videos/**/assets/music/*
!videos/**/assets/music/.gitkeep
videos/**/assets/sfx/*
!videos/**/assets/sfx/.gitkeep
# Persistent Freesound cache/index is runtime data, never repository media.
runtime/sfx_library/
runtime/freesound_music_library/
videos/**/pipeline/TELEGRAM_NOTIFICATION_STATE.json
videos/**/pipeline/TELEGRAM_NOTIFICATION_STATE.json.lock

# Per-video execution metadata is durable engineering evidence and must stay
# eligible for Git even when generated media itself is ignored.
!videos/**/visual_pipeline/
!videos/**/visual_pipeline/*.json
