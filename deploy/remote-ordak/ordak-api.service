[Unit]
Description=Ordak ChatGPT browser automation API
After=network-online.target ordak-chrome.service
Wants=network-online.target
Requires=ordak-chrome.service

[Service]
Type=simple
User=root
WorkingDirectory=/opt/YT_Video_Generation_Pipeline
Environment=DISPLAY=:1
ExecStart=/opt/YT_Video_Generation_Pipeline/.venv/bin/python scripts/run_ordak.py
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
