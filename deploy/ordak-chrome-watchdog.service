[Unit]
Description=Ordak Chrome DevTools watchdog
After=network.target ordak-xvfb.service

[Service]
Type=oneshot
User=root
Environment=DISPLAY=:99
Environment=ORDAK_CHROME_PROFILE_DIR=/root/.config/google-chrome-ordak
Environment=ORDAK_CHROME_PROFILE_NAME=Default
Environment=ORDAK_CHROME_STARTUP_URL=https://pixabay.com/music/ambient-ambient-stillness-478783/
ExecStart=/root/YT_Video_Generation_Pipeline/scripts/ordak_chrome_watchdog.sh
